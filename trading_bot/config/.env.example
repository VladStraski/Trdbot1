# ==========================================================================
#  Trading Bot — пример конфигурации.
#  Скопировать в trading_bot/config/.env и заполнить. Реальный .env в .gitignore.
# ==========================================================================

# --- Окружение (явный выбор, без автоопределения) ---
#   demo  -> https://api-demo.bybit.com   (Bybit Demo Trading)
#   prod  -> https://api.bybit.com        (реальная торговля)
BYBIT_ENV=demo

# --- Ключи DEMO (Bybit Demo Trading) ---
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# --- Ключи PROD (реальная торговля) — заполнять только при переходе на prod ---
BYBIT_PROD_API_KEY=
BYBIT_PROD_API_SECRET=

# --- Торговый инструмент ---
SYMBOL=BTCUSDT
CATEGORY=linear
MARGIN_MODE=ISOLATED          # ISOLATED (по ТЗ) | CROSS

# --- Таймфреймы (Triple Screen) ---
TF_CONTEXT=4h                 # слой контекста (тренд)
TF_SIGNAL=1h                  # слой сигнала (точка входа)
TF_TRIGGER=15m                # слой триггера (тайминг)

# --- Risk management (доли equity) ---
RISK_PCT_PER_TRADE=0.01       # риск на сделку, 1% equity
MAX_PORTFOLIO_RISK=0.03       # суммарный риск по открытым позициям, 3%
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT=0.03         # -3% equity за день -> стоп торговли до конца дня
MAX_CONSECUTIVE_LOSSES=5      # -> пауза + уведомление
MAX_DRAWDOWN=0.15             # -15% от пика equity -> полная остановка
LEVERAGE_HARD_CAP=5           # жёсткий потолок плеча
ATR_STOP_MULT=1.75            # k в stop_distance = k * ATR
MIN_RR=1.5                    # минимальный R:R на вход

# --- Confluence scoring ---
ENTRY_SCORE_THRESHOLD=6       # порог суммы очков для входа

# --- Storage ---
DB_PATH=trading_bot/storage/trades.sqlite

# --- Логирование ---
LOG_LEVEL=INFO
LOG_DIR=trading_bot/logs

# --- Telegram (опционально, Этап 10) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
